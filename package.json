{
  "name": "renewable-incident-board",
  "version": "1.0.0",
  "private": true,
  "description": "Renewable Operations Incident Board — triage, investigate and record follow-up on solar/BESS alerts",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @incident-board/shared",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @incident-board/api",
    "dev:web": "npm run dev --workspace @incident-board/web",
    "prebuild": "npm run build:shared",
    "build": "npm run build --workspace @incident-board/api && npm run build --workspace @incident-board/web",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspace @incident-board/api && npm run test --workspace @incident-board/web",
    "test:api": "npm run test --workspace @incident-board/api",
    "test:web": "npm run test --workspace @incident-board/web",
    "test:coverage": "npm run test:coverage --workspace @incident-board/api",
    "e2e": "npm run test --workspace @incident-board/e2e",
    "e2e:ui": "npm run test:ui --workspace @incident-board/e2e",
    "eval": "npm run eval --workspace @incident-board/api",
    "seed": "npm run seed --workspace @incident-board/api",
    "migrate": "npm run migrate --workspace @incident-board/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
